# ─── Admin Server Configuration ─────────────────────────────────────────────
ADMIN_SERVER_PORT=4000
NODE_ENV=development

# ─── Database ───────────────────────────────────────────────────────────────
# Connect to the exact same MongoDB database as MatchWise AI
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ─── Admin Client URL ───────────────────────────────────────────────────────
ADMIN_CLIENT_URL=http://localhost:3001

# ─── JWT Secrets ────────────────────────────────────────────────────────────
# Must match the main backend JWT secrets if tokens are shared, or use dedicated admin secrets
JWT_ACCESS_SECRET=replace-with-a-long-random-string-min-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string-min-32-chars
ACCESS_TOKEN_EXPIRY=30m
REFRESH_TOKEN_EXPIRY=7d

# ─── Security ───────────────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development          # "development" | "production"

# ─── Database ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate strong secrets (min 32 chars). Example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string-min-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string-min-32-chars

# Access token lifetime — must be between 15m and 45m (enforced in token.utils.js)
ACCESS_TOKEN_EXPIRY=15m

# Refresh token lifetime — must be between 7d and 30d (enforced in token.utils.js)
REFRESH_TOKEN_EXPIRY=7d

# ─── Security ─────────────────────────────────────────────────────────────────
# bcrypt cost factor — 10 is the minimum enforced; 12 recommended for production
BCRYPT_SALT_ROUNDS=12

# ─── CORS / Client ────────────────────────────────────────────────────────────
# Production frontend URL. In development, http://localhost:5173 is also allowed automatically.
CLIENT_URL=http://MatchwiseAI-1052301444.ap-south-1.elb.amazonaws.com

# Set to true only when the ALB is serving HTTPS. Keep false for the current HTTP ALB.
COOKIE_SECURE=false

# ─── AI — Google Gemini ───────────────────────────────────────────────────────
# Used by both ai.service.js (ATS resume / interview report)
# and resumeJobMatchService.js (job-match criteria extraction).
# Get your key at: https://aistudio.google.com/app/apikey
GOOGLE_GENAI_API_KEY=AIza...

# ─── Job Search — RapidAPI / JSearch ─────────────────────────────────────────
# Subscribe to JSearch at: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPID_API_KEY=your-rapidapi-key-here

# ─── Token Storage ────────────────────────────────────────────────────────────
# Refresh tokens are currently stored in an in-memory Map (tokenCache.js) that
# mirrors the Redis client API. This works perfectly for single-instance deploys
# (Render free tier, etc.) but does NOT persist across restarts or scale across
# multiple instances.
#
# To upgrade to real Redis, replace tokenCache.js with:
#
#   import { createClient } from 'redis';
#   const redisClient = createClient({ url: process.env.REDIS_URL });
#   await redisClient.connect();
#   export default redisClient;
#
# Then uncomment the line below and install: npm install redis
# REDIS_URL=redis://default:<password>@<host>:<port>

# ─── Admin Account ────────────────────────────────────────────────────────────
# There are NO hard-coded admin credentials.
# To promote an existing registered user to admin, run:
#
#   node scripts/seed-admin.js --email=you@example.com
#
# Or set the email here and run: node scripts/seed-admin.js
# ADMIN_EMAIL=you@example.com
#
# The target user must already be registered via the normal sign-up flow.
# The script is idempotent: running it twice on the same user is a no-op.
# The promoted user must log out and log back in for the new role to take effect.
